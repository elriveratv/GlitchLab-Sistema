RewriteEngine On

# 1. Si la petición viene del subdominio de rastreo (rastreo.glitchlab.mx):
# Servir rastreo.html directamente en la raíz
RewriteCond %{HTTP_HOST} ^rastreo\. [NC]
RewriteRule ^$ rastreo.html [L,QSA]

# 2. Rutas amigables para rastreo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^rastreo/?$ rastreo.html [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^seguimiento/?$ rastreo.html [L,QSA]
